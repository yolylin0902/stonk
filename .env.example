# ================================================================
# 環境變數範本 (.env.example)
# 請複製此檔案為 .env 並填入實際的金鑰資訊
# 注意：切勿將包含實際金鑰的 .env 提交至 Git 倉庫！
# ================================================================

# --- Supabase 設定 ---
# 在 Supabase 專案設定 -> API 頁面取得
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Python 腳本與 GitHub Actions 使用（可直接沿用上述 anon key，或使用 service_role key）
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# --- Google Gemini AI 設定 ---
# 在 Google AI Studio (https://aistudio.google.com/) 取得 API Key
GEMINI_API_KEY=your-gemini-api-key

# Gemini 模型設定（建議使用 gemini-3.5-flash 或 gemini-3.5-flash-lite）
GEMINI_MODEL=gemini-3.5-flash
